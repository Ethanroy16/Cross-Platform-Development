<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HealthTrackingApp.MainPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F4F8F6">

    <Grid RowDefinitions="*,Auto">


        <!-- ================================= -->
        <!-- MAIN DASHBOARD                    -->
        <!-- ================================= -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="24,25,24,20"
                Spacing="18">


                <!-- ============================= -->
                <!-- HEADER                         -->
                <!-- ============================= -->

                <Grid
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Good morning 👋"
                            FontSize="15"
                            TextColor="#6B7A76" />

                        <Label
                            Text="Your Health"
                            FontSize="31"
                            FontAttributes="Bold"
                            TextColor="#17211F" />

                        <Label
                            Text="Here's how you're doing today"
                            FontSize="14"
                            TextColor="#7C8A86" />

                    </VerticalStackLayout>


                    <!-- Profile button -->

                    <Button
                        Grid.Column="1"
                        Text="●"
                        FontSize="20"
                        TextColor="White"
                        BackgroundColor="#19B89A"
                        WidthRequest="52"
                        HeightRequest="52"
                        CornerRadius="26"
                        Padding="0"
                        VerticalOptions="Center"
                        Clicked="OnProfileClicked" />

                </Grid>


                <!-- ============================= -->
                <!-- DAY PROGRESS                   -->
                <!-- ============================= -->

                <Frame
                    BackgroundColor="#19B89A"
                    BorderColor="#19B89A"
                    CornerRadius="22"
                    Padding="20"
                    HasShadow="False">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label
                                Text="Today's Progress"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="You're doing great!"
                                FontSize="13"
                                TextColor="#DDF8F1" />

                            <Label
                                Text="75% complete"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="White"
                                Margin="0,8,0,0" />

                        </VerticalStackLayout>


                        <!-- Progress percentage -->

                        <Label
                            Grid.Column="1"
                            Text="75%"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center"
                            Margin="10,0,5,0" />

                    </Grid>

                </Frame>


                <!-- ============================= -->
                <!-- HEALTH SUMMARY                 -->
                <!-- ============================= -->

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="*,*"
                    ColumnSpacing="12"
                    RowSpacing="12">


                    <!-- STEPS -->

                    <Frame
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="#E6F8F3"
                        BorderColor="#B8EBDD"
                        CornerRadius="20"
                        Padding="17"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="STEPS"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#159477" />

                            <Label
                                Text="8,450"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#17211F" />

                            <Label
                                Text="steps today"
                                FontSize="12"
                                TextColor="#6B7A76" />

                            <Label
                                Text="84% of goal"
                                FontSize="11"
                                TextColor="#19B89A"
                                Margin="0,3,0,0" />

                        </VerticalStackLayout>

                    </Frame>


                    <!-- WATER -->

                    <Frame
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="#EAF7FF"
                        BorderColor="#B9E5FA"
                        CornerRadius="20"
                        Padding="17"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="WATER"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#249BD0" />

                            <Label
                                Text="1.7 L"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#17211F" />

                            <Label
                                Text="of 2.0 L goal"
                                FontSize="12"
                                TextColor="#6B7A76" />

                            <Label
                                Text="85% complete"
                                FontSize="11"
                                TextColor="#249BD0"
                                Margin="0,3,0,0" />

                        </VerticalStackLayout>

                    </Frame>


                    <!-- SLEEP -->

                    <Frame
                        Grid.Row="1"
                        Grid.Column="0"
                        BackgroundColor="#F1EDFF"
                        BorderColor="#D9D0FF"
                        CornerRadius="20"
                        Padding="17"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="SLEEP"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#7156D9" />

                            <Label
                                Text="7h 24m"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#17211F" />

                            <Label
                                Text="last night"
                                FontSize="12"
                                TextColor="#6B7A76" />

                            <Label
                                Text="Good sleep"
                                FontSize="11"
                                TextColor="#7156D9"
                                Margin="0,3,0,0" />

                        </VerticalStackLayout>

                    </Frame>


                    <!-- HEART -->

                    <Frame
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="#FFF0F3"
                        BorderColor="#FFD0DA"
                        CornerRadius="20"
                        Padding="17"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="HEART RATE"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#E64363" />

                            <Label
                                Text="72 BPM"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#17211F" />

                            <Label
                                Text="current"
                                FontSize="12"
                                TextColor="#6B7A76" />

                            <Label
                                Text="Normal"
                                FontSize="11"
                                TextColor="#E64363"
                                Margin="0,3,0,0" />

                        </VerticalStackLayout>

                    </Frame>

                </Grid>


                <!-- ============================= -->
                <!-- STEPS CHART                    -->
                <!-- ============================= -->

                <Frame
                    BackgroundColor="White"
                    BorderColor="#E4ECE9"
                    CornerRadius="22"
                    Padding="16"
                    HasShadow="False">

                    <VerticalStackLayout
                        Spacing="4">


                        <!-- Chart header -->

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="Steps"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#17211F" />

                                <Label
                                    Text="Your activity this week"
                                    FontSize="12"
                                    TextColor="#7C8A86" />

                            </VerticalStackLayout>


                            <Label
                                Grid.Column="1"
                                Text="52,430"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#19B89A"
                                VerticalOptions="Center" />

                        </Grid>


                        <!-- GRAPH -->

                        <GraphicsView
                            x:Name="StepsChart"
                            HeightRequest="155"
                            HorizontalOptions="Fill"
                            Margin="0,8,0,0" />


                        <!-- DAYS -->

                        <Grid
                            ColumnDefinitions="*,*,*,*,*,*,*"
                            Margin="0,-2,0,0">

                            <Label
                                Grid.Column="0"
                                Text="Mon"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="1"
                                Text="Tue"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="2"
                                Text="Wed"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="3"
                                Text="Thu"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="4"
                                Text="Fri"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="5"
                                Text="Sat"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                            <Label
                                Grid.Column="6"
                                Text="Sun"
                                HorizontalTextAlignment="Center"
                                FontSize="10"
                                TextColor="#7C8A86" />

                        </Grid>

                    </VerticalStackLayout>

                </Frame>


                <!-- ============================= -->
                <!-- MOTIVATION CARD                -->
                <!-- ============================= -->

                <Frame
                    BackgroundColor="#17211F"
                    BorderColor="#17211F"
                    CornerRadius="22"
                    Padding="20"
                    HasShadow="False">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="Keep going! 💪"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="You're only 1,550 steps away from your daily goal."
                            FontSize="13"
                            TextColor="#C7D3CF" />

                    </VerticalStackLayout>

                </Frame>


                <!-- Bottom spacing -->

                <BoxView
                    HeightRequest="5"
                    Color="Transparent" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- ================================= -->
        <!-- BOTTOM NAVIGATION                 -->
        <!-- ================================= -->

        <!-- ================================= -->
        <!-- BOTTOM NAVIGATION                 -->
        <!-- ================================= -->

        <Border
    Grid.Row="1"
    BackgroundColor="White"
    Stroke="#E3EBE8"
    StrokeThickness="1"
    Padding="5,6,5,6">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Grid
        ColumnDefinitions="*,*,*,*,*"
        ColumnSpacing="2">

                <!-- HOME -->

                <Button
            Grid.Column="0"
            Text="⌂&#10;Home"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="Transparent"
            TextColor="#19B89A"
            Padding="0"
            HeightRequest="58"
            Clicked="OnHomeClicked" />

                <!-- EXERCISE -->

                <Button
            Grid.Column="1"
            Text="Exercise"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="Transparent"
            TextColor="#6B7A76"
            Padding="0"
            HeightRequest="58"
            Clicked="OnExerciseClicked" />

                <!-- PROGRESS -->

                <Button
            Grid.Column="2"
            Text="Progress"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="Transparent"
            TextColor="#6B7A76"
            Padding="0"
            HeightRequest="58"
            Clicked="OnProgressClicked" />

                <!-- SLEEP -->

                <Button
            Grid.Column="3"
            Text="Sleep"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="Transparent"
            TextColor="#6B7A76"
            Padding="0"
            HeightRequest="58"
            Clicked="OnSleepClicked" />

                <!-- HEART -->

                <Button
            Grid.Column="4"
            Text="♥&#10;Heart"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="Transparent"
            TextColor="#FF4D6D"
            Padding="0"
            HeightRequest="58"
            Clicked="OnHeartClicked" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>