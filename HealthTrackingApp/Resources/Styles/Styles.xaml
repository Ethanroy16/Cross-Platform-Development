<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HealthTrackingApp.Resources.Styles.Styles">

    <!-- PAGE -->

    <Style TargetType="ContentPage">

        <Setter Property="BackgroundColor"
                Value="{StaticResource PageBackground}" />

    </Style>


    <!-- LABEL -->

    <Style TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

    </Style>


    <!-- FRAME -->

    <Style TargetType="Frame">

        <Setter Property="BackgroundColor"
                Value="{StaticResource CardBackground}" />

        <Setter Property="BorderColor"
                Value="{StaticResource BorderLight}" />

        <Setter Property="CornerRadius"
                Value="20" />

        <Setter Property="HasShadow"
                Value="False" />

        <Setter Property="Padding"
                Value="16" />

    </Style>


    <!-- NORMAL BUTTON -->

    <Style TargetType="Button">

        <Setter Property="BackgroundColor"
                Value="{StaticResource HomeGreen}" />

        <Setter Property="TextColor"
                Value="White" />

        <Setter Property="FontAttributes"
                Value="Bold" />

        <Setter Property="CornerRadius"
                Value="16" />

        <Setter Property="HeightRequest"
                Value="50" />

    </Style>


    <!-- ENTRY -->

    <Style TargetType="Entry">

        <Setter Property="BackgroundColor"
                Value="White" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextLight}" />

        <Setter Property="HeightRequest"
                Value="50" />

    </Style>


    <!-- PICKER -->

    <Style TargetType="Picker">

        <Setter Property="BackgroundColor"
                Value="White" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="HeightRequest"
                Value="50" />

    </Style>


    <!-- DATE -->

    <Style TargetType="DatePicker">

        <Setter Property="BackgroundColor"
                Value="White" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="HeightRequest"
                Value="50" />

    </Style>


    <!-- TIME -->

    <Style TargetType="TimePicker">

        <Setter Property="BackgroundColor"
                Value="White" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="HeightRequest"
                Value="50" />

    </Style>


    <!-- EDITOR -->

    <Style TargetType="Editor">

        <Setter Property="BackgroundColor"
                Value="White" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextLight}" />

    </Style>

</ResourceDictionary>