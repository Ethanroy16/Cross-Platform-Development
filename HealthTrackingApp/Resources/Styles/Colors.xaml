<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HealthTrackingApp.Resources.Styles.Colors">

    <!-- General -->

    <Color x:Key="PageBackground">#F4F8F6</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <Color x:Key="TextPrimary">#17211F</Color>
    <Color x:Key="TextSecondary">#6B7A76</Color>
    <Color x:Key="TextLight">#9AA8A4</Color>

    <Color x:Key="BorderLight">#E3EBE8</Color>


    <!-- Home -->

    <Color x:Key="HomeGreen">#19B89A</Color>
    <Color x:Key="HomeLight">#E6F8F3</Color>


    <!-- Exercise -->

    <Color x:Key="ExerciseOrange">#FF8A3D</Color>
    <Color x:Key="ExerciseLight">#FFF1E7</Color>


    <!-- Progress -->

    <Color x:Key="ProgressBlue">#3B82F6</Color>
    <Color x:Key="ProgressLight">#EAF2FF</Color>


    <!-- Sleep -->

    <Color x:Key="SleepPurple">#7C5CFC</Color>
    <Color x:Key="SleepLight">#F1EDFF</Color>


    <!-- Heart -->

    <Color x:Key="HeartRed">#FF4D6D</Color>
    <Color x:Key="HeartLight">#FFF0F3</Color>


    <!-- Profile -->

    <Color x:Key="ProfileTeal">#00A896</Color>
    <Color x:Key="ProfileLight">#E6F7F5</Color>

</ResourceDictionary>